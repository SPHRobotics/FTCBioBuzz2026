public void forward(double speed, double time) {


        runtime.reset();
        while (opModeIsActive() && (runtime.seconds() < time)) {
            RF.setPower(speed);
            LF.setPower(speed);
            RB.setPower(speed);
            LB.setPower(speed);
        }
}
    public void backward(double speed, double time) {


        runtime.reset();
        while (opModeIsActive() && (runtime.seconds() < time)) {

            RF.setPower(-speed);
            LF.setPower(-speed);
            RB.setPower(-speed);
            LB.setPower(-speed);
        }
    }

    public void right(double speed, double time) {


        runtime.reset();
        while (opModeIsActive() && (runtime.seconds() < time)) {
            RF.setPower(-speed);
            LF.setPower(speed);
            RB.setPower(speed);
            LB.setPower(-speed);
        }
    }
    public void left(double speed, double time) {


        runtime.reset();
        while (opModeIsActive() && (runtime.seconds() < time)) {
            RF.setPower(speed);
            LF.setPower(-speed);
            RB.setPower(-speed);
            LB.setPower(speed);
        }
    }
    public void spinRight(double speed, double time) {


        runtime.reset();
        while (opModeIsActive() && (runtime.seconds() < time)) {
            RF.setPower(-speed);
            LF.setPower(speed);
            RB.setPower(-speed);
            LB.setPower(speed);
        }
    }
    public void spinLeft(double speed, double time) {


        runtime.reset();
        while (opModeIsActive() && (runtime.seconds() < time)) {
            RF.setPower(speed);
            LF.setPower(-speed);
            RB.setPower(speed);
            LB.setPower(-speed);
        }
    }
    public void rearAxisTurn(double speed, double time) {


        runtime.reset();
        while (opModeIsActive() && (runtime.seconds() < time)) {
            RF.setPower(-speed);
            LF.setPower(speed);
            RB.setPower(0);
            LB.setPower(0);
        }
    }
    public void frontAxisTurn(double speed, double time) {


        runtime.reset();
        while (opModeIsActive() && (runtime.seconds() < time)) {
            RF.setPower(0);
            LF.setPower(0);
            RB.setPower(speed);
            LB.setPower(-speed);
        }

    public void brake(double time) {


        runtime.reset();
        while (opModeIsActive() && (runtime.seconds() < time)) {
            RF.setPower(0);
            LF.setPower(0);
            RB.setPower(0);
            LB.setPower(0);
        }


        }
}
