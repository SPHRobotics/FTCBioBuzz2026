 public void forward(double speed, double time, boolean flywheel) {




        runtime.reset();
        while (opModeIsActive() && (runtime.seconds() < time)) {
            RF.setPower(speed);
            LF.setPower(speed);
            RB.setPower(speed);
            LB.setPower(speed);

            if (flywheel) {
                SM.setPower(SM_POWER);
                SB.setPower(SB_POWER);

            }
        }
}
