    public void rearAxisTurn(double speed, double time, boolean flywheel) {


        runtime.reset();
        while (opModeIsActive() && (runtime.seconds() < time)) {
            RF.setPower(-speed);
            LF.setPower(speed);
            RB.setPower(0);
            LB.setPower(0);

            if (flywheel == true) {
                SM.setPower(SM_POWER);
                SB.setPower(SB_POWER);

            }
        }
    }
